<?xml version="1.0" encoding="utf-8"?>
<AxSecurityPrivilege xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>HSMobileOpsPostQueueManage</Name>
	<Description>Correct the quantity on a failed mobile posting, or cancel it. Supervisors only: this decides what stock is booked.</Description>
	<Label>Manage mobile posting queue</Label>
	<DirectAccessPermissions />
	<EntryPoints>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsPostQueueChangeQty</Name>
			<Grant>
				<Read>Allow</Read>
			</Grant>
			<ObjectName>HSMobileOpsPostQueueChangeQty</ObjectName>
			<ObjectType>MenuItemAction</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsPostQueueCancel</Name>
			<Grant>
				<Read>Allow</Read>
			</Grant>
			<ObjectName>HSMobileOpsPostQueueCancel</ObjectName>
			<ObjectType>MenuItemAction</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
	</EntryPoints>
	<FormControlOverrides />
</AxSecurityPrivilege>
