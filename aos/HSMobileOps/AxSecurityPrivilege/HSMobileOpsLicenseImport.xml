<?xml version="1.0" encoding="utf-8"?>
<AxSecurityPrivilege xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>HSMobileOpsLicenseImport</Name>
	<Label>Upload license</Label>
	<HelpText>Upload the license file the vendor sent, and see the current license status and device usage. HSMobileOpsLicenseSetup's own insert()/update() verify the pair before saving - this privilege only gates who can reach the form at all.</HelpText>
	<EntryPoints>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsLicenseSetup</Name>
			<ObjectName>HSMobileOpsLicenseSetup</ObjectName>
			<ObjectType>MenuItemDisplay</ObjectType>
			<AccessLevel>Update</AccessLevel>
		</AxSecurityEntryPointReference>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsLicenseUpload</Name>
			<Grant>
				<Read>Allow</Read>
			</Grant>
			<ObjectName>HSMobileOpsLicenseUpload</ObjectName>
			<ObjectType>MenuItemAction</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
	</EntryPoints>
	<Tables>
		<AxSecurityPrivilegeTablePermission>
			<Name>HSMobileOpsLicenseSetup</Name>
			<Delete>NoAccess</Delete>
			<Insert>Allow</Insert>
			<Read>Allow</Read>
			<Update>Allow</Update>
		</AxSecurityPrivilegeTablePermission>
		<AxSecurityPrivilegeTablePermission>
			<Name>HSMobileOpsLicenseUpload</Name>
			<Delete>NoAccess</Delete>
			<Insert>Allow</Insert>
			<Read>Allow</Read>
			<Update>NoAccess</Update>
		</AxSecurityPrivilegeTablePermission>
	</Tables>
</AxSecurityPrivilege>
