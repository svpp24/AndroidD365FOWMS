	<Label>Maintain cycle count warehouses</Label>
	<DirectAccessPermissions />
	<EntryPoints>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsCountWarehouse</Name>
			<Grant>
				<Read>Allow</Read>
				<Update>Allow</Update>
				<Create>Allow</Create>
				<Delete>Allow</Delete>
			</Grant>
			<ObjectName>HSMobileOpsCountWarehouse</ObjectName>
			<ObjectType>MenuItemDisplay</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsCountW2WStart</Name>
			<Grant>
				<Invoke>Allow</Invoke>
			</Grant>
			<ObjectName>HSMobileOpsCountW2WStart</ObjectName>
			<ObjectType>MenuItemAction</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsCountW2WPost</Name>
			<Grant>
				<Invoke>Allow</Invoke>
			</Grant>
			<ObjectName>HSMobileOpsCountW2WPost</ObjectName>
			<ObjectType>MenuItemAction</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsCountW2WCancel</Name>
			<Grant>
				<Invoke>Allow</Invoke>
			</Grant>
			<ObjectName>HSMobileOpsCountW2WCancel</ObjectName>
			<ObjectType>MenuItemAction</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
