<?xml version="1.0" encoding="utf-8"?>
<AxSecurityPrivilege xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>HSMobileOpsPostQueueView</Name>
	<Description>See every posting from the handhelds, its status, the reason if it failed, and its GRN, and retry a failed one.</Description>
	<Label>View mobile posting queue</Label>
	<DirectAccessPermissions />
	<EntryPoints>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsPostQueue</Name>
			<Grant>
				<Read>Allow</Read>
			</Grant>
			<ObjectName>HSMobileOpsPostQueue</ObjectName>
			<ObjectType>MenuItemDisplay</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
		<AxSecurityEntryPointReference>
			<Name>HSMobileOpsPostQueueRetry</Name>
			<Grant>
				<Read>Allow</Read>
			</Grant>
			<ObjectName>HSMobileOpsPostQueueRetry</ObjectName>
			<ObjectType>MenuItemAction</ObjectType>
			<Forms />
		</AxSecurityEntryPointReference>
	</EntryPoints>
	<FormControlOverrides />
</AxSecurityPrivilege>
