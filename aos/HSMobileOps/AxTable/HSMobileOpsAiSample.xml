<?xml version="1.0" encoding="utf-8"?>
<AxTable xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>HSMobileOpsAiSample</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// AI count training samples, uploaded by the handhelds: the worker's confirmed count and marks,
/// with the photo as a standard attachment (document storage, not this table). Shared by every
/// device and app of the company for training a model on its own products. Bounded: at most
/// maxPerItem() samples per item are accepted.
/// </summary>
public class HSMobileOpsAiSample extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>maxPerItem</Name>
				<Source><![CDATA[

    public static int maxPerItem()
    {
        return 50;
    }
]]></Source>
			</Method>
		</Methods>
	</SourceCode>
	<Label>Mobile AI count sample</Label>
	<TitleField1>ItemId</TitleField1>
	<TitleField2>Quantity</TitleField2>
	<ClusteredIndex>SampleIdx</ClusteredIndex>
	<PrimaryIndex>SampleIdx</PrimaryIndex>
	<ReplacementKey>SampleIdx</ReplacementKey>
	<Fields>
		<AxTableField xmlns=""
			i:type="AxTableFieldString">
			<Name>SampleId</Name>
			<AllowEdit>No</AllowEdit>
			<HelpText>Generated on the handheld; makes a repeated upload a no-op.</HelpText>
			<Label>Sample ID</Label>
			<Mandatory>Yes</Mandatory>
			<StringSize>40</StringSize>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldString">
			<Name>ItemId</Name>
			<AllowEdit>No</AllowEdit>
			<ExtendedDataType>ItemId</ExtendedDataType>
			<Label>Item number</Label>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldInt">
			<Name>Quantity</Name>
			<AllowEdit>No</AllowEdit>
			<Label>Confirmed count</Label>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldInt">
			<Name>Corrections</Name>
			<AllowEdit>No</AllowEdit>
			<HelpText>Boxes the worker removed plus marks added - how far the model was off.</HelpText>
			<Label>Corrections</Label>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldString">
			<Name>Annotation</Name>
			<AllowEdit>No</AllowEdit>
			<ExtendedDataType>Notes</ExtendedDataType>
			<HelpText>Image size, the boxes the model proposed with whether they were kept, and the marks the worker added - in the attached photo's pixels.</HelpText>
			<Label>Marks (JSON)</Label>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldString">
			<Name>DeviceId</Name>
			<AllowEdit>No</AllowEdit>
			<Label>Device</Label>
			<StringSize>64</StringSize>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldString">
			<Name>UserName</Name>
			<AllowEdit>No</AllowEdit>
			<ExtendedDataType>HSMobileOpsUserName</ExtendedDataType>
			<Label>Counted by</Label>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldString">
			<Name>WarehouseId</Name>
			<AllowEdit>No</AllowEdit>
			<ExtendedDataType>InventLocationId</ExtendedDataType>
			<Label>Warehouse</Label>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldString">
			<Name>ImageBase64</Name>
			<AllowEdit>No</AllowEdit>
			<ExtendedDataType>Notes</ExtendedDataType>
			<HelpText>The photo as base64 JPEG, only when it could not be stored as an attachment (document storage unavailable).</HelpText>
			<Label>Photo (fallback, base64 JPEG)</Label>
		</AxTableField>
		<AxTableField xmlns=""
			i:type="AxTableFieldUtcDateTime">
			<Name>CapturedUtc</Name>
			<AllowEdit>No</AllowEdit>
			<Label>Captured</Label>
		</AxTableField>
	</Fields>
	<FullTextIndexes />
	<Indexes>
		<AxTableIndex>
			<Name>SampleIdx</Name>
			<AllowDuplicates>No</AllowDuplicates>
			<Fields>
				<AxTableIndexField>
					<DataField>SampleId</DataField>
				</AxTableIndexField>
			</Fields>
		</AxTableIndex>
		<AxTableIndex>
			<Name>ItemIdx</Name>
			<AllowDuplicates>Yes</AllowDuplicates>
			<Fields>
				<AxTableIndexField>
					<DataField>ItemId</DataField>
				</AxTableIndexField>
			</Fields>
		</AxTableIndex>
	</Indexes>
	<Mappings />
	<Relations />
	<StateMachines />
</AxTable>
