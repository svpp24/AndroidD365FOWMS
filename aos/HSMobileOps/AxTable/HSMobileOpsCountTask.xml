	<Name>HSMobileOpsCountTask</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Wall-to-wall count tasks: one per location of the count's journal. The handheld picks up a
/// task, not raw lines; the counter marks the location complete, or empty. A journal cannot post
/// until every task is Completed.
/// </summary>
public class HSMobileOpsCountTask extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[

    public static HSMobileOpsCountTask find(InventJournalId _journalId, WMSLocationId _location, boolean _forUpdate = false)
    {
        HSMobileOpsCountTask task;

        task.selectForUpdate(_forUpdate);
        select firstOnly task
            where task.JournalId     == _journalId
               && task.WMSLocationId == _location;
        return task;
    }
]]></Source>
			</Method>
			<Method>
				<Name>openTasks</Name>
				<Source><![CDATA[

    /// <summary>Tasks of this journal not yet Completed.</summary>
    public static int openTasks(InventJournalId _journalId)
    {
        HSMobileOpsCountTask task;

        select count(RecId) from task
            where task.JournalId == _journalId
               && task.Status    != HSMobileOpsCountTaskStatus::Completed;
        return int642int(task.RecId);
    }
]]></Source>
			</Method>
		</Methods>
	</SourceCode>
