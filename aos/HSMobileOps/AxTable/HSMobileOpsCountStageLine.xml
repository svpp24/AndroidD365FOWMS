	<Name>HSMobileOpsCountStageLine</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// One counted quantity: an item (with its product dimensions, batch and serial) at a location,
/// by one counter. DuplicateKey identifies "the same stock"; two or more lines with the same key
/// in one stock count are a duplicate (IsDuplicate) the supervisor decides (Decision): keep one
/// count, add them together, or reject them for a recount. Included says whether the line goes
/// into the counting journal at Transfer. Quantity is in the item's inventory unit.
/// </summary>
public class HSMobileOpsCountStageLine extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    public static HSMobileOpsCountStageLine findRecId(RefRecId _recId)
    {
        HSMobileOpsCountStageLine line;

        select firstonly line where line.RecId == _recId;
        return line;
    }
]]></Source>
			</Method>
		</Methods>
	</SourceCode>
