<?xml version="1.0" encoding="utf-8"?>
<AxTable xmlns:i="http://www.w3.org/2001/XMLSchema-instance">
	<Name>HSMobileOpsDeviceWork</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Unsent work saved from a handheld (HSMobileOpsDeviceWorkSvc): one row per posting waiting or
/// refused, unfinished job, order draft or count not yet accepted, per device. Removed as the
/// device reports it done. What a worker restores after a reinstall or on a new device, and what
/// a supervisor can see on Mobile unsent work. One list for the environment, like the device fleet.
/// </summary>
public class HSMobileOpsDeviceWork extends common
{
}
]]></Declaration>
		<Methods>
		</Methods>
	</SourceCode>
	<Label>Mobile unsent work</Label>
	<TitleField1>Reference</TitleField1>
	<TitleField2>UserName</TitleField2>
	<CacheLookup>NotInTTS</CacheLookup>
	<ReplacementKey>DeviceWorkIdx</ReplacementKey>
	<SaveDataPerCompany>No</SaveDataPerCompany>
