	<EnumValues>
		<AxEnumValue>
			<Name>New</Name>
			<Label>New</Label>
			<Value>0</Value>
		</AxEnumValue>
		<AxEnumValue>
			<Name>InProgress</Name>
			<Label>In progress</Label>
			<Value>1</Value>
		</AxEnumValue>
		<AxEnumValue>
			<Name>Done</Name>
			<Label>Done</Label>
			<Value>2</Value>
		</AxEnumValue>
		<AxEnumValue>
			<Name>WontDo</Name>
			<Label>Won't do</Label>
			<Value>3</Value>
		</AxEnumValue>
