					<Method>
						<Name>lookup</Name>
						<Source><![CDATA[
        /// <summary>
        /// The other menus, by ID and name.
        /// </summary>
        public void lookup()
        {
            SysTableLookup       menuLookup = SysTableLookup::newParameters(tableNum(HSMobileOpsMenu), this);
            Query                query = new Query();
            QueryBuildDataSource menuDataSource = query.addDataSource(tableNum(HSMobileOpsMenu));

            if (HSMobileOpsMenu.MenuId)
            {
                menuDataSource.addRange(fieldNum(HSMobileOpsMenu, MenuId)).value(SysQuery::valueNot(HSMobileOpsMenu.MenuId));
            }
            menuLookup.addLookupfield(fieldNum(HSMobileOpsMenu, MenuId), true);
            menuLookup.addLookupfield(fieldNum(HSMobileOpsMenu, Name));
            menuLookup.parmQuery(query);
            menuLookup.performFormLookup();
        }

]]></Source>
