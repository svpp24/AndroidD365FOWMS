				<Source><![CDATA[
/// <summary>
/// Mobile device menus: the handheld's Home organised into menus and sub-menus, like the
/// mobile device menus of Warehouse management. Each line opens an app module or another menu,
/// in Sequence order. The default menu is Home for every worker without a menu of their own
/// (Mobile device users, Handheld menu). Menu access still hides the modules a worker may not use.
/// </summary>
[Form]
public class HSMobileOpsMenu extends FormRun
{
}
]]></Source>
			</Method>
