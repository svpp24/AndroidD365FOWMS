					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        /// Shows the selected menu's lines (see HSMobileOpsMenuLine.init).
        /// </summary>
        public int active()
        {
            int ret = super();

            HSMobileOpsMenuLine_ds.executeQuery();
            return ret;
        }

]]></Source>
					</Method>
				</Methods>
