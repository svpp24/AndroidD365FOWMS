			<DataSource>
				<Name>HSMobileOpsMenuLine</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// Links the lines to the selected menu explicitly: the relation alone did not filter the
        /// grid, which showed every menu's lines.
        /// </summary>
        public void init()
        {
            super();
            this.queryBuildDataSource().clearDynalinks();
            this.queryBuildDataSource().addDynalink(fieldNum(HSMobileOpsMenuLine, MenuRecId), HSMobileOpsMenu, fieldNum(HSMobileOpsMenu, RecId));
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        /// <summary>
        /// Below the grid, a menu item line shows Menu item and a sub-menu line shows Sub-menu -
        /// only the one that applies.
        /// </summary>
        public int active()
        {
            int     ret = super();
            boolean isSubMenu = HSMobileOpsMenuLine.LineType == HSMobileOpsMenuLineType::SubMenu;

            Line_Module.visible(!isSubMenu);
            Line_SubMenuId.visible(isSubMenu);
            return ret;
        }

]]></Source>
					</Method>
