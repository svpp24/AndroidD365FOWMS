/// <summary>
/// Mobile posting queue (Inquiries): every posting handed over by a handheld in this company,
/// newest first - what it became, the reason if it failed, and the GRN if Auto GRN posted one.
/// Read only, apart from its actions on a failed posting, all from the lines staged on its row:
/// Retry (also on the handheld), and for supervisors Change quantity and Cancel posting.
/// </summary>
[Form]
public class HSMobileOpsPostQueue extends FormRun
{
}
]]></Source>
