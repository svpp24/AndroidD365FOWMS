        super();
        HSMobileOpsPostQueue_ds.query().dataSourceTable(tableNum(HSMobileOpsPostQueue)).addSortField(fieldNum(HSMobileOpsPostQueue, ReceivedUtc), SortOrder::Descending);
    }
]]></Source>
