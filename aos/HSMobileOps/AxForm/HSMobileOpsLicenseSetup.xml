				<Source><![CDATA[
/// <summary>
/// The License page (user, 16 Nov 2026): the license is changed only by uploading the license
/// file the vendor sends (HSMobileOpsLicenseFile) - the certificate and license key show masked
/// and cannot be edited here. Every upload, accepted or refused, is listed under License uploads.
///
/// License status and Devices in use are display methods on HSMobileOpsLicenseSetup that re-run
/// the same HSMobileOpsLicense::verify() a sign-in does, so this page never drifts from what a
/// worker sees.
/// </summary>
[Form]
public class HSMobileOpsLicenseSetup extends FormRun
{
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[

    public void init()
    {
        super();
        // Newest upload first.
        HSMobileOpsLicenseUpload_ds.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsLicenseUpload, UploadedUtc), SortOrder::Descending);
    }

]]></Source>
