				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// Where an administrator pastes the certificate and license the vendor issued - see
/// HSMobileOpsLicenseSetup and HSMobileOpsLicense. One row for the whole environment;
/// InsertIfEmpty means it always shows something to edit even before anyone has ever pasted
/// anything in.
///
/// Both fields are ordinary editable bound fields on this form - the verification that keeps
/// this table from ever holding a certificate/license pair that would not actually verify lives
/// in HSMobileOpsLicenseSetup's own insert()/update() overrides, not in the form. A save that
/// does not verify throws rather than persisting, the same shape the earlier design already
/// used here for encrypting PublicKeyXml on save.
///
/// LicenseStatus and DeviceUsage are read-only display methods (HSMobileOpsLicenseSetup table) -
/// not stored fields, see that table's class doc on why expiry/device-limit are never kept as
/// their own editable columns. They re-run the exact same HSMobileOpsLicense::verify() /
/// HSMobileOpsDevice::activeDeviceCount() calls HSMobileOpsUserService::signIn() itself uses, so
/// what shows here can never drift from what a worker actually experiences at sign-in.
/// </summary>
[Form]
public class HSMobileOpsLicenseSetup extends FormRun
{
}
]]></Source>
			</Method>
