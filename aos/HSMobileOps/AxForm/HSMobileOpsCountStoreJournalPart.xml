				<Source><![CDATA[
			/// <summary>
			/// Count control center FactBox: the selected store journal, and why it won't post yet.
			/// </summary>
			[Form]
			public class HSMobileOpsCountStoreJournalPart extends FormRun
			{
			}
			]]></Source>
