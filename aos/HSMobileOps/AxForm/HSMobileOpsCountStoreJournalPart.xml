		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>HSMobileOpsCountStoreJournal</Name>
				<Methods>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
					        public int active()
					        {
					            int                          ret = super();
					            HSMobileOpsCountStoreJournal storeJournal = HSMobileOpsCountStoreJournal;

					            StoreText.text(strFmt('%1 %2', storeJournal.InventLocationId, storeJournal.StoreName));
					            WontPost.visible(storeJournal.CountedTwiceCount > 0 && !storeJournal.Posted);
					            WontPost.text(strFmt("Won't post until %1 bin(s) are decided.", storeJournal.CountedTwiceCount));
					            if (storeJournal.Posted)
					            {
					                PostingText.text(strFmt('Posted %1', storeJournal.PostedDate));
					            }
					            else if (storeJournal.OnHold)
					            {
					                PostingText.text(strFmt('On hold by %1', storeJournal.HoldBy));
					            }
					            else
					            {
					                PostingText.text('Nightly batch');
					            }
					            return ret;
					        }
					]]></Source>
					</Method>
				</Methods>
			</DataSource>
