	<Name>HSMobileOpsCountSelectedBinPart</Name>
	<SourceCode>
		<Methods xmlns="">
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
			/// <summary>
			/// Count control center FactBox: every count of the selected bin counted twice, and what they
			/// add up to.
			/// </summary>
			[Form]
			public class HSMobileOpsCountSelectedBinPart extends FormRun
			{
			}
			]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>HSMobileOpsCountStageLine</Name>
				<Methods>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
					        public int active()
					        {
					            int                       ret = super();
					            HSMobileOpsCountStageLine selected = HSMobileOpsCountStageLine;
					            HSMobileOpsCountStageLine total;

					            LocationBin.text(selected.BinId ? strFmt('%1 / %2', selected.WMSLocationId, selected.BinId) : selected.WMSLocationId);
					            ItemText.text(strFmt('%1 %2', selected.ItemId, selected.ItemName));
					            OnHand.realValue(selected.OnHandQty);
					            if (selected.StoreJournalRecId)
					            {
					                select sum(Qty) from total
					                    where total.StoreJournalRecId == selected.StoreJournalRecId
					                       && total.DuplicateKey      == selected.DuplicateKey;
					            }
					            else
					            {
					                select sum(Qty) from total
					                    where total.MasterRecId  == selected.MasterRecId
					                       && total.DuplicateKey == selected.DuplicateKey;
					            }
					            AddedTogether.realValue(selected.RecId ? total.Qty : 0);
					            BinCount_ds.executeQuery();
					            return ret;
					        }
					]]></Source>
					</Method>
				</Methods>
			</DataSource>
			<DataSource>
				<Name>BinCount</Name>
				<Methods>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
					        /// <summary>
					        /// The selected bin's counts, first count first.
					        /// </summary>
					        public void executeQuery()
					        {
					            QueryBuildDataSource      source = this.queryBuildDataSource();
					            HSMobileOpsCountStageLine selected = HSMobileOpsCountStageLine;

					            SysQuery::findOrCreateRange(source, fieldNum(HSMobileOpsCountStageLine, DuplicateKey)).value(SysQuery::value(selected.DuplicateKey));
					            SysQuery::findOrCreateRange(source, fieldNum(HSMobileOpsCountStageLine, StoreJournalRecId)).value(selected.StoreJournalRecId ? SysQuery::value(selected.StoreJournalRecId) : '');
					            SysQuery::findOrCreateRange(source, fieldNum(HSMobileOpsCountStageLine, MasterRecId)).value(selected.StoreJournalRecId ? '' : SysQuery::value(selected.MasterRecId));
					            super();
					        }
					]]></Source>
					</Method>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
					        public void init()
					        {
					            super();
					            this.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsCountStageLine, CountedUtc));
					        }
					]]></Source>
					</Method>
				</Methods>
			</DataSource>
		</DataSources>
