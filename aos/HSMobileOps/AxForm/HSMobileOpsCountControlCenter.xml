	<Name>HSMobileOpsCountControlCenter</Name>
	<SourceCode>
		<Methods xmlns="">
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// Stock count control center: every store's stock counts (master journals) with one staging
/// journal per counter and their counted lines. Items counted more than once - by the same
/// counter or another - are flagged; the supervisor keeps one count, adds them together or
/// rejects them, then transfers the stock count into a D365FO counting journal. A supervisor
/// with stores in Stock count stores sees only those stores. Rules: HSMobileOpsCountControl.
/// </summary>
[Form]
public class HSMobileOpsCountControlCenter extends FormRun
{
}
]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>HSMobileOpsCountMaster</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// Only the stores this supervisor manages, newest count first. Nobody set up in Stock
        /// count stores sees every store.
        /// </summary>
        public void init()
        {
            HSMobileOpsCountStore store;

            super();
            while select InventLocationId from store where store.SupervisorUserId == curUserId()
            {
                this.queryBuildDataSource().addRange(fieldNum(HSMobileOpsCountMaster, InventLocationId)).value(queryValue(store.InventLocationId));
            }
            this.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsCountMaster, StartedUtc), SortOrder::Descending);
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();

            HSMobileOpsCountStage_ds.executeQuery();
            HSMobileOpsCountStageLine_ds.executeQuery();
            return ret;
        }

]]></Source>
					</Method>
				</Methods>
			</DataSource>
			<DataSource>
				<Name>HSMobileOpsCountStage</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();
            this.queryBuildDataSource().clearDynalinks();
            this.queryBuildDataSource().addDynalink(fieldNum(HSMobileOpsCountStage, MasterRecId), HSMobileOpsCountMaster, fieldNum(HSMobileOpsCountMaster, RecId));
        }

]]></Source>
					</Method>
				</Methods>
			</DataSource>
			<DataSource>
				<Name>HSMobileOpsCountStageLine</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// The selected stock count's lines, duplicates together (same stock, then counter).
        /// </summary>
        public void init()
        {
            super();
            this.queryBuildDataSource().clearDynalinks();
            this.queryBuildDataSource().addDynalink(fieldNum(HSMobileOpsCountStageLine, MasterRecId), HSMobileOpsCountMaster, fieldNum(HSMobileOpsCountMaster, RecId));
            this.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsCountStageLine, DuplicateKey));
            this.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsCountStageLine, UserName));
        }

]]></Source>
					</Method>
					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        /// <summary>
        /// Duplicates only, when that box is ticked.
        /// </summary>
        public void executeQuery()
        {
            QueryBuildRange duplicateRange = SysQuery::findOrCreateRange(this.queryBuildDataSource(), fieldNum(HSMobileOpsCountStageLine, IsDuplicate));

            duplicateRange.value(DuplicatesOnly.value() ? queryValue(NoYes::Yes) : '');
            super();
        }

]]></Source>
					</Method>
				</Methods>
