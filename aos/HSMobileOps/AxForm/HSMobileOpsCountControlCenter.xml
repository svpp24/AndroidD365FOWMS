	<Name>HSMobileOpsCountControlCenter</Name>
	<SourceCode>
		<Methods xmlns="">
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// Stock count control center: every store's stock counts (master journals) with one staging
/// journal per counter and their counted lines. Items counted more than once - by the same
/// counter or another - are flagged; the supervisor keeps one count, adds them together or
/// rejects them, then creates the counting journal (Create journal). Three count types (10 Nov 2026):
/// Wall to wall, Hazard (asked for by an outside system) and Blind (New blind count, items on the
/// Requested items tab). On-hand and variance are recorded on each line as it arrives. A supervisor
/// with stores in Stock count stores sees only those stores. Rules: HSMobileOpsCountControl.
/// </summary>
[Form]
public class HSMobileOpsCountControlCenter extends FormRun
{
}
]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>HSMobileOpsCountMaster</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        /// Only the stores this supervisor manages, newest count first. Nobody set up in Stock
        /// count stores sees every store.
        /// </summary>
        public void init()
        {
            HSMobileOpsCountStore store;

            super();
            while select InventLocationId from store where store.SupervisorUserId == curUserId()
            {
                this.queryBuildDataSource().addRange(fieldNum(HSMobileOpsCountMaster, InventLocationId)).value(queryValue(store.InventLocationId));
            }
            this.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsCountMaster, StartedUtc), SortOrder::Descending);
        }

]]></Source>
					</Method>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();

            // Blind and hazard counts (user, 13 Nov: a hazard count can start here too) take their
            // items on this tab while open.
            boolean blindOpen = (HSMobileOpsCountMaster.MasterType == HSMobileOpsCountMasterType::Blind
                              || HSMobileOpsCountMaster.MasterType == HSMobileOpsCountMasterType::Hazard)
                             && HSMobileOpsCountMaster.Status     == HSMobileOpsCountMasterStatus::Open;

            HSMobileOpsCountStage_ds.executeQuery();
            HSMobileOpsCountStageLine_ds.executeQuery();
            HSMobileOpsCountItem_ds.executeQuery();
            HSMobileOpsCountItem_ds.allowCreate(blindOpen);
            HSMobileOpsCountItem_ds.allowEdit(blindOpen);
            HSMobileOpsCountItem_ds.allowDelete(blindOpen);
            return ret;
        }

]]></Source>
					</Method>
				</Methods>
