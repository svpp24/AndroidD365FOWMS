	<Name>HSMobileOpsDeviceSetupQr</Name>
	<SourceCode>
		<Methods xmlns="">
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// The QR code of a device setup code (New device setup code, Show QR code). The code itself is not
/// kept: Show QR code gives the code a new value, and the QR code shown before stops working.
/// </summary>
[Form]
public class HSMobileOpsDeviceSetupQr extends FormRun
{
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        str setupText;

        super();
        setupText = element.args() ? element.args().parm() : '';
        if (!setupText)
        {
            throw error('Open this from New device setup code.');
        }
        QrText.text(setupText);
        QrImage.image(new Image(HSMobileOpsDeviceSetupCodeNew::qrPng(setupText)));
    }
]]></Source>
			</Method>
		</Methods>
