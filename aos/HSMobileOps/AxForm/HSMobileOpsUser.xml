				<Source><![CDATA[
/// <summary>
/// Mobile device users, and the warehouses each may work in.
///
/// The only place these accounts are created, reset and deactivated. The handheld deliberately has
/// no administration screen: user setup belongs where D365FO's own security governs who may do it,
/// not on a device that lives on a warehouse floor and is shared between shifts.
///
/// The password is never shown, never stored in clear and never editable as a field. It can only
/// be *set*, through the button, which routes to HSMobileOpsUserAdmin so that hashing has exactly
/// one implementation - a form that rolled its own salt would create rows the handheld could never
/// authenticate against, and the failure would look like a wrong password rather than a bug.
/// </summary>
[Form]
public class HSMobileOpsUser extends FormRun
{
}
]]></Source>
