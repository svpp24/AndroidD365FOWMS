			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// Sync health: one screen for the handhelds' item sync - a summary on top, then every
/// warehouse (what its devices get, its snapshot, its devices), every device (oldest successful
/// sync first) and every item snapshot build.
/// </summary>
[Form]
public class HSMobileOpsSyncHealth extends FormRun
{
    QueryBuildRange retiredRange;
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[

    public void init()
    {
        HSMobileOpsWarehouseControl::fillWarehouses();
        super();
        // The devices that need a look first: worst health, then oldest successful sync. Retired
        // devices hidden unless Show retired is ticked (16 Nov 2026).
        HSMobileOpsDeviceSync_ds.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsDeviceSync, HealthStatus), SortOrder::Descending);
        HSMobileOpsDeviceSync_ds.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsDeviceSync, LastSuccessUtc), SortOrder::Ascending);
        retiredRange = HSMobileOpsDeviceSync_ds.queryBuildDataSource().addRange(fieldNum(HSMobileOpsDeviceSync, HealthStatus));
        retiredRange.value(SysQuery::valueNot(HSMobileOpsDeviceHealth::Retired));
        HSMobileOpsSkuSnapshot_ds.queryBuildDataSource().addSortField(fieldNum(HSMobileOpsSkuSnapshot, BuiltAtUtc), SortOrder::Descending);
        this.showSummary();
    }
]]></Source>
			</Method>
			<Method>
				<Name>showSummary</Name>
				<Source><![CDATA[

    /// <summary>The company snapshot, the stores, the devices - three lines.</summary>
    public void showSummary()
    {
        HSMobileOpsSkuSnapshot      snapshot;
        HSMobileOpsSkuSnapshot      company = HSMobileOpsSkuSnapshot::current('');
        HSMobileOpsDeviceSync       device;
        HSMobileOpsDeviceHealth     health;
        HSMobileOpsWarehouseControl control;
        int                         ready;
        int                         building;
        int                         failed;
        int                         devices;
        int                         failing;
        int                         stale;
        str                         line1;
        str                         line2;
        str                         line3;

        select firstOnly snapshot
            order by snapshot.BuiltAtUtc desc
            where snapshot.Scope == '';
        if (company.RecId)
        {
            line1 = strFmt('Company item snapshot: Ready, built %1 (%2 hours ago) in %3 seconds.', company.BuiltAtUtc,
                DateTimeUtil::getDifference(DateTimeUtil::utcNow(), company.BuiltAtUtc) div 3600, company.BuildSeconds);
        }
        else
        {
            line1 = 'Company item snapshot: none ready, so a full sync pages through the items.';
        }
        if (snapshot.RecId && snapshot.RecId != company.RecId)
        {
            line1 += strFmt(' Newest build: %1. %2', snapshot.Status,
                snapshot.Status == HSMobileOpsSkuSnapshot::statusFailed() ? snapshot.Result : '');
        }

        select count(RecId) from control
            where control.SyncByAssortment == NoYes::Yes;
        while select Status from snapshot
            where snapshot.Scope != ''
        {
            if (snapshot.Status == HSMobileOpsSkuSnapshot::statusReady())
            {
                ready++;
            }
            else if (snapshot.Status == HSMobileOpsSkuSnapshot::statusBuilding())
            {
                building++;
            }
            else
            {
                failed++;
            }
        }
        line2 = strFmt('Warehouses syncing by store assortment: %1. Store snapshots: %2 ready, %3 building, %4 failed.',
            control.RecId, ready, building, failed);

        while select device
        {
            health = device.computeHealth();
            if (health == HSMobileOpsDeviceHealth::Retired)
            {
                continue;
            }
            switch (health)
            {
                case HSMobileOpsDeviceHealth::Failing:
                case HSMobileOpsDeviceHealth::QueueStuck:
                    failing++;
                    break;
                case HSMobileOpsDeviceHealth::Stale:
                case HSMobileOpsDeviceHealth::Offline:
                case HSMobileOpsDeviceHealth::NeverSynced:
                    stale++;
                    break;
            }
            devices++;
        }
        line3 = strFmt('Devices: %1. OK: %2, failing or postings stuck: %3, stale or not seen: %4. Checked every hour; Mobile administrators get an alert.',
            devices, devices - failing - stale, failing, stale);

        Summary.text(line1 + '\n' + line2 + '\n' + line3);
    }
]]></Source>
			</Method>
