				<Name>refreshAll</Name>
				<Source><![CDATA[

    /// <summary>Everything read again - after Refresh or Check device health now.</summary>
    public void refreshAll()
    {
        HSMobileOpsWarehouseControl_ds.research(true);
        HSMobileOpsDeviceSync_ds.research(true);
        HSMobileOpsSkuSnapshot_ds.research(true);
        this.showSummary();
    }
]]></Source>
