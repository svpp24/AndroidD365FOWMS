        public boolean modified()
        {
            boolean ret = super();
            retiredRange.value(this.value() ? '' : SysQuery::valueNot(HSMobileOpsDeviceHealth::Retired));
            HSMobileOpsDeviceSync_ds.research(true);
            return ret;
        }

