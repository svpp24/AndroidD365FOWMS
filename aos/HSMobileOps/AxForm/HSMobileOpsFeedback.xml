/// <summary>
/// Feedback sent from the handheld, newest first. Set Status and Reply - the worker sees both in
/// the app. The screenshot, when one was sent, is under Attachments.
/// </summary>
[Form]
public class HSMobileOpsFeedback extends FormRun
{
}
]]></Source>
