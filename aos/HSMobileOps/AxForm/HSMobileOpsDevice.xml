				<Source><![CDATA[
/// <summary>
/// The handheld fleet: every device that has signed into ForeFront Mobile, populated
/// automatically on sign-in - see HSMobileOpsDevice::registerSignIn.
///
/// Read-only except for the Active flag. There is nothing else here for a person to set: brand,
/// model, last user and last warehouse are all reported by the device itself, and editing them
/// on this form would just make them wrong the next time that device signs in and overwrites
/// them anyway.
/// </summary>
[Form]
public class HSMobileOpsDevice extends FormRun
{
}
]]></Source>
