	<Name>HSMobileOpsWorkspace</Name>
	<SourceCode>
		<Methods xmlns="">
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// Mobile operations workspace: one landing page for what needs attention in the handheld app.
/// Each tile counts the query of its menu item; the same query opens the list, so the number
/// equals the rows. The queries are scoped to the user's stores by HSMobileOpsWorkspaceScope.
/// </summary>
[Form]
public class HSMobileOpsWorkspace extends FormRun implements SysIFilterProvider
{
    SysFilterChangeEvent changeEvent;
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        super();

        FilterStringControl.text(HSMobileOpsWorkspaceFilter::current());
        changeEvent = SysFilterChangeEvent::newFromFormControl(FilterStringControl);
        WorkspaceWarehouseFilter.visible(HSMobileOpsWorkspaceScope::isAllStores() || HSMobileOpsWorkspaceScope::warehouses().elements() > 1);

        if (!HSMobileOpsWorkspaceScope::hasAnyStore())
        {
            warning("No store is assigned to you, so nothing is shown. Ask an administrator to link your worker to a handheld user with a warehouse.");
        }
    }
]]></Source>
			</Method>
			<Method>
				<Name>parmFilter</Name>
				<Source><![CDATA[
    public SysIFilter parmFilter()
    {
        // The warehouse is applied by HSMobileOpsWorkspaceScope inside the tile queries, so the
        // filter handed to the tiles carries no items. It only makes the tiles refresh.
        return SysFilterFactory::createEmptyFilter();
    }
]]></Source>
			</Method>
			<Method>
				<Name>parmChangeEvent</Name>
				<Source><![CDATA[
    public SysFilterChangeEvent parmChangeEvent()
    {
        return changeEvent;
    }
]]></Source>
			</Method>
