<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the on-device load generator (debugtools/LoadTestReceiver). DUMP is held
     by adb shell and not grantable to ordinary apps, so nothing else on the device can start it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.d365fo.mobileops.debugtools.LoadTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: simulated D365FO outage for offline testing (debugtools/SimulateOutageReceiver). -->
        <receiver
            android:name="com.d365fo.mobileops.debugtools.SimulateOutageReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: one read-only OData query, logged (debugtools/ODataProbeReceiver). -->
        <receiver
            android:name="com.d365fo.mobileops.debugtools.ODataProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: one raw custom-service call, logged (debugtools/ServiceProbeReceiver). -->
        <receiver
            android:name="com.d365fo.mobileops.debugtools.ServiceProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
