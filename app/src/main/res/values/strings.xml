<resources>
    <string name="app_name">ForeFront Mobile</string>

    <!-- Generic -->
    <string name="action_retry">Retry</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_confirm">Confirm</string>
    <string name="action_post">Post</string>
    <string name="action_save_draft">Save draft</string>
    <string name="action_back">Back</string>
    <string name="action_search">Search</string>
    <string name="action_clear">Clear</string>
    <string name="loading">Loading…</string>

    <!-- Connectivity / sync status bar -->
    <string name="status_online">Online</string>
    <string name="status_offline">Offline — work is saved on this device</string>
    <string name="status_d365_unreachable">D365FO unreachable — work is saved on this device</string>
    <string name="status_back_online">Back online</string>
    <string name="status_pending_count">%1$d pending</string>
    <string name="status_last_sync">Last sync %1$s</string>
    <string name="status_never_synced">Never synced</string>
    <string name="status_failed_count">%1$d failed — supervisor review</string>

    <!-- Scanning -->
    <string name="scan_prompt">Scan item barcode</string>
    <string name="scan_or_type">Scan or type</string>
